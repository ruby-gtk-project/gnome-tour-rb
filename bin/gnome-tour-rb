#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/gnome_tour_rb'

# `build` answers the Gtk::Application, so the test driver can hang its own
# handlers off it; running goes through our own object, which passes the
# command line on to GApplication. Its exit status becomes ours, the way
# upstream's `main` returns the `glib::ExitCode`.
exit(GnomeTourRb::Application.new.tap(&:build).run)
